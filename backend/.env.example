# ── Required secrets (MUST be set in production) ─────────────────────────────

# Database
DB_USER=ssssy
DB_PASSWORD=CHANGE_ME_use_a_strong_random_password

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_a_strong_256bit_hex_secret

# Redis (leave blank to disable auth; strongly recommended to set in prod)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password

# Storage (minio or local)
STORAGE_TYPE=minio
MINIO_ACCESS_KEY=CHANGE_ME_minio_access_key
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_key
MINIO_BUCKET=ssssy-media

# ── Application ───────────────────────────────────────────────────────────────

# Public base URL of the site (no trailing slash)
APP_BASE_URL=https://ssssyria.org

# Allowed CORS origins — comma-separated, NO wildcard when cookies are used
APP_CORS_ALLOWED_ORIGINS=https://ssssyria.org,https://www.ssssyria.org

# Cookie security — must be "true" in production (HTTPS required)
APP_COOKIE_SECURE=true

# Spring active profile — "prod" (default in Dockerfile) or "dev"
SPRING_PROFILES_ACTIVE=prod

# Swagger/OpenAPI — disable in production, enable in staging/dev
APP_SWAGGER_ENABLED=false

# Log level — INFO in production, DEBUG in dev
LOG_LEVEL=INFO

# ── SMTP (required for email sending) ────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@ssssyria.org
SMTP_PASSWORD=CHANGE_ME_smtp_password

# ── IMAP (required for email sync) ───────────────────────────────────────────
IMAP_HOST=imap.example.com
IMAP_PORT=143

# ── Trusted reverse-proxy IPs (comma-separated) ──────────────────────────────
# Add the IP of your nginx/load-balancer here so X-Forwarded-For is trusted
TRUSTED_PROXIES=127.0.0.1,::1,172.18.0.0/16

# ── ClamAV antivirus (optional) ──────────────────────────────────────────────
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_FAIL_ON_UNAVAILABLE=false

# ── Frontend build-time env (used in docker-compose.prod.yml build args) ─────
# These are inlined at Next.js build time — change requires a rebuild.
NEXT_PUBLIC_API_URL=https://ssssyria.org/api
NEXT_PUBLIC_APP_URL=https://ssssyria.org
NEXT_PUBLIC_APP_NAME=SSSSY
# URL where MinIO/S3 assets are publicly served
NEXT_PUBLIC_STORAGE_URL=https://ssssyria.org/storage
